{
  "name": "resumora",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "concurrently -n api,web \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "eval:import": "npm run eval:import -w apps/api",
    "eval:enrich": "npm run eval:enrich -w apps/api",
    "eval:jobs": "npm run eval:jobs -w apps/api",
    "eval:tailor": "npm run eval:tailor -w apps/api",
    "eval:golden": "npm run eval:golden -w apps/api",
    "lint": "eslint .",
    "build": "npm run build --workspaces --if-present",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "concurrently": "10.0.6",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
