{
  "name": "resumora",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": ">=22.13.0 <23",
    "npm": ">=10 <11"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "worker:imports": "node --experimental-strip-types scripts/import-worker.mjs --watch",
    "dev:web": "npm run dev --workspace @resumora/web",
    "dev:api": "npm run dev --workspace @resumora/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspace @resumora/web && npm run build --workspace @resumora/api",
    "smoke": "node scripts/smoke.mjs",
    "test:dev-secrets": "node --test scripts/dev-secret-boundary.test.mjs",
    "check": "npm run typecheck && npm run test:web && npm run build && npm run smoke && npm run test:dev-secrets && npm run test:dev-config",
    "test:web": "npm run test --workspace @resumora/web",
    "dev:start": "node scripts/dev-service.mjs start",
    "dev:stop": "node scripts/dev-service.mjs stop",
    "dev:status": "node scripts/dev-service.mjs status",
    "test:dev-config": "node --test scripts/dev-config.test.mjs scripts/dev-service.test.mjs scripts/dev-processes.test.mjs scripts/dev-doctor.test.mjs",
    "dev:doctor": "node scripts/dev-doctor.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
