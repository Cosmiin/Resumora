# Copy to .dev.vars (ignored). Supabase values from `supabase status`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=<anon key from supabase status>
SUPABASE_SERVICE_ROLE_KEY=<service role key from supabase status>
APP_ORIGIN=http://127.0.0.1:5173

# AI for CV import. OpenRouter is tried first, OpenAI if it fails. Leave a key empty to skip that provider.
# Use models that support structured output (json_schema). Chosen 2026-11-04 by a test on sample CVs:
# about $0.002 and 4 s per import on OpenRouter; the OpenAI fallback is dearer but never guesses dates.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
