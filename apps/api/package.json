  "dependencies": {
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/png": "3.1.1",
    "@jsquash/webp": "1.5.0",
    "@resumora/contracts": "0.0.0",
    "@supabase/auth-js": "2.118.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261025.1",
    "wrangler": "4.152.0"
  }
}
