{
  "name": "@resumora/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "dev:admin-demo": "node --experimental-strip-types scripts/admin-demo.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "prebuild": "node ../../scripts/build-print.mjs",
    "pretest": "node ../../scripts/build-print.mjs"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "@cloudflare/puppeteer": "1.4.0",
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/png": "3.1.1",
    "@jsquash/webp": "1.5.0",
    "@resumora/contracts": "0.0.0",
    "@supabase/auth-js": "2.118.0",
    "cfb": "1.2.2",
    "fflate": "0.8.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261025.1",
    "wrangler": "4.152.0",
    "pdfjs-dist": "5.4.624",
    "@napi-rs/canvas": "0.1.100"
  }
}
