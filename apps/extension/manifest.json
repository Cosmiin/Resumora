{
  "manifest_version": 3,
  "name": "Resumora — Capture a job",
  "version": "0.1.0",
  "description": "Save the job you choose to your Resumora account. Capture on click, then review.",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "scripting", "storage", "identity", "alarms"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {"service_worker":"src/worker.js","type":"module"},
  "action": {"default_popup":"popup.html","default_title":"Capture this job in Resumora"},
  "icons": {"16":"icons/16.png","48":"icons/48.png","128":"icons/128.png"},
  "content_security_policy": {"extension_pages":"script-src 'self'; object-src 'none'; base-uri 'none'"}
}
