{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "journey-workspace-1.1.0"
    },
    "workspaceId": {
      "type": "string",
      "minLength": 1
    },
    "synthetic": {
      "const": true
    },
    "uiLocale": {
      "enum": [
        "ro",
        "en"
      ]
    },
    "cvLocale": {
      "enum": [
        "ro",
        "en"
      ]
    },
    "baseSnapshotId": {
      "type": [
        "string",
        "null"
      ]
    },
    "applications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "jobSnapshotId": {
            "type": "string",
            "minLength": 1
          },
          "cvSnapshotId": {
            "type": [
              "string",
              "null"
            ]
          },
          "exportId": {
            "type": [
              "string",
              "null"
            ]
          },
          "stage": {
            "enum": [
              "saved",
              "drafting",
              "applied",
              "interview",
              "offer",
              "closed"
            ]
          },
          "stageSource": {
            "const": "user_managed"
          },
          "contactIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "nextActionId": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "jobSnapshotId",
          "cvSnapshotId",
          "exportId",
          "stage",
          "stageSource",
          "contactIds",
          "nextActionId"
        ]
      }
    },
    "contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "company": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "channelKind": {
            "enum": [
              "email",
              "link",
              "phone"
            ]
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "sourceKind": {
            "const": "user_entry"
          },
          "purpose": {
            "const": "application_context"
          },
          "private": {
            "const": true
          }
        },
        "required": [
          "id",
          "name",
          "company",
          "role",
          "channelKind",
          "value",
          "sourceKind",
          "purpose",
          "private"
        ]
      }
    },
    "nextActions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "applicationId": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "review_job",
              "tailor_cv",
              "review_eligibility",
              "send_application",
              "follow_up",
              "prepare_interview"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "dueDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "state": {
            "enum": [
              "open",
              "done",
              "cancelled"
            ]
          },
          "reminderMode": {
            "const": "none"
          }
        },
        "required": [
          "id",
          "applicationId",
          "kind",
          "label",
          "dueDate",
          "state",
          "reminderMode"
        ]
      }
    },
    "linkedinReviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sourceKind": {
            "enum": [
              "own_user_paste",
              "manual"
            ]
          },
          "ownProfileAttested": {
            "const": true
          },
          "sourceTextHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "baseSnapshotId": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "draft",
              "queued",
              "review_ready",
              "failed_retryable",
              "dismissed"
            ]
          },
          "proposedClaimIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "actualProfileWritten": {
            "const": false
          }
        },
        "required": [
          "id",
          "sourceKind",
          "ownProfileAttested",
          "sourceTextHash",
          "baseSnapshotId",
          "state",
          "proposedClaimIds",
          "actualProfileWritten"
        ]
      }
    },
    "draftPatches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "targetSectionId": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "skills",
              "summary",
              "bullet"
            ]
          },
          "mode": {
            "enum": [
              "append",
              "replace"
            ]
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 1
          },
          "beforeItemIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "proposedItemIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "sourceClaimIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "state": {
            "enum": [
              "proposed",
              "accepted_in_draft",
              "rejected",
              "undone"
            ]
          },
          "factsAutomaticallyConfirmed": {
            "const": false
          }
        },
        "required": [
          "id",
          "targetSectionId",
          "kind",
          "mode",
          "expectedRevision",
          "beforeItemIds",
          "proposedItemIds",
          "sourceClaimIds",
          "state",
          "factsAutomaticallyConfirmed"
        ]
      }
    },
    "realMessagesSent": {
      "const": false
    },
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "company": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title",
          "company"
        ],
        "additionalProperties": false
      }
    },
    "cvVersions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "applicationId": {
            "type": "string",
            "minLength": 1
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "state": {
            "enum": [
              "completed",
              "pending",
              "failed",
              "superseded"
            ]
          },
          "targetJobSnapshotId": {
            "type": [
              "string",
              "null"
            ]
          },
          "tailoringOrigin": {
            "enum": [
              "none",
              "user_selection",
              "ai_assisted"
            ]
          }
        },
        "required": [
          "id",
          "applicationId",
          "sequence",
          "state",
          "targetJobSnapshotId",
          "tailoringOrigin"
        ],
        "additionalProperties": false
      }
    },
    "sentRecords": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "applicationId": {
            "type": "string",
            "minLength": 1
          },
          "cvSnapshotId": {
            "type": "string",
            "minLength": 1
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time"
          },
          "occurredOn": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "source": {
            "const": "user_attestation"
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 1
          },
          "retracted": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "applicationId",
          "cvSnapshotId",
          "recordedAt",
          "occurredOn",
          "source",
          "idempotencyKey",
          "retracted"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "workspaceId",
    "synthetic",
    "uiLocale",
    "cvLocale",
    "baseSnapshotId",
    "applications",
    "contacts",
    "nextActions",
    "linkedinReviews",
    "draftPatches",
    "realMessagesSent",
    "jobs",
    "cvVersions",
    "sentRecords"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/cv/v1/journey-workspace-v1.1.schema.json",
  "title": "Discovery workspace companion;separatefromcanonicalCV"
}
