{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "versions": {
      "type": "object",
      "properties": {
        "profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "document": {
          "type": "string",
          "minLength": 1
        },
        "job": {
          "type": "string",
          "minLength": 1
        },
        "requirements": {
          "type": "string",
          "minLength": 1
        },
        "dictionary": {
          "type": "string",
          "minLength": 1
        },
        "normalizer": {
          "type": "string",
          "minLength": 1
        },
        "matcher": {
          "type": "string",
          "minLength": 1
        },
        "rules": {
          "type": "string",
          "minLength": 1
        },
        "asOf": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "profile",
        "document",
        "job",
        "requirements",
        "dictionary",
        "normalizer",
        "matcher",
        "rules",
        "asOf"
      ],
      "additionalProperties": false
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "canonicalId": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "technical",
              "responsibilities",
              "experience",
              "achievements",
              "qualifications",
              "professional",
              "title"
            ]
          },
          "priority": {
            "enum": [
              "required",
              "unspecified",
              "preferred"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "jobEvidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "polarity": {
            "enum": [
              "positive",
              "not_required",
              "ambiguous"
            ]
          },
          "hardGate": {
            "type": "boolean"
          },
          "gateKind": {
            "enum": [
              null,
              "credential",
              "authorization",
              "nonnegotiable"
            ]
          },
          "allowEquivalent": {
            "type": "boolean"
          },
          "allowTransferableEquivalent": {
            "type": "boolean"
          },
          "priorityFraction": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "alternatives": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "category",
          "priority",
          "text",
          "jobEvidence",
          "polarity",
          "hardGate",
          "gateKind",
          "allowEquivalent"
        ],
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "requirementId": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "enum": [
              "profile",
              "cv"
            ]
          },
          "claimIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "documentItemIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "claimState": {
            "enum": [
              "user_confirmed",
              "externally_verified",
              "extracted_unconfirmed",
              "suggested",
              "rejected"
            ]
          },
          "matchClass": {
            "enum": [
              "demonstrated",
              "claimed_limited",
              "transferable",
              "not_evidenced"
            ]
          },
          "relation": {
            "enum": [
              "exact",
              "approved_equivalent",
              "transferable",
              "unsupported"
            ]
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "fulfillment": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "alternativeId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "requirementId",
          "scope",
          "claimIds",
          "documentItemIds",
          "claimState",
          "matchClass",
          "relation",
          "explanation"
        ],
        "additionalProperties": false
      }
    },
    "eligibilityAssertions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "requirementId": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "const": "confirmed_unmet"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "sourceId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "requirementId",
          "state",
          "reason",
          "actor",
          "sourceId"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "versions",
    "requirements",
    "evidence",
    "eligibilityAssertions"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/cv/v1/assessment-input-1.1.schema.json",
  "title": "Pinned CV/profile to job assessment input1.1 (separate from canonical CV)"
}
