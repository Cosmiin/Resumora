{
  "version": "readiness-review-1.0.0",
  "approved": false,
  "meaning": "Completion of explicit document review checks,not writing quality,job suitability,legal eligibility or PDF extraction",
  "categories": {
    "content": {
      "weight": 20,
      "checks": [
        "identity_contact_confirmed",
        "positioning_reviewed",
        "supported_summary_reviewed",
        "skill_groups_reviewed",
        "experience_or_education_reviewed"
      ]
    },
    "structure": {
      "weight": 20,
      "checks": [
        "canonical_schema_valid",
        "date_precision_preserved",
        "section_order_reviewed",
        "private_contacts_excluded"
      ]
    },
    "job_optimization": {
      "weight": 20,
      "checks": [
        "job_requirements_reviewed",
        "relevant_selection_reviewed",
        "hard_gaps_reviewed",
        "job_cv_version_pinned"
      ],
      "applicable": "job_available"
    },
    "writing": {
      "weight": 20,
      "checks": [
        "document_language_reviewed",
        "unsupported_claims_absent",
        "selected_bullet_reviewed",
        "metrics_sourced_or_omitted"
      ]
    },
    "application": {
      "weight": 20,
      "checks": [
        "chosen_cv_reviewed",
        "contact_visibility_reviewed",
        "next_action_recorded",
        "application_state_user_managed"
      ],
      "applicable": "application_started"
    }
  },
  "naRule": "Only explicitcontextabsence;neverremovebecausecheckfailed",
  "pendingRule": "Applicablependingcountsunfinished;showcoverage/Notassessed,notbadquality",
  "semanticScoresAffected": false,
  "readabilityIncluded": false
}
