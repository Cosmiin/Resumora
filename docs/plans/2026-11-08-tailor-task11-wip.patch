+.job-application-status select, .job-thoughts textarea { width: 100%; min-width: 0; padding: var(--space-3); font: inherit; color: var(--text-body); border: 1px solid var(--border-field); border-radius: var(--radius-field); background: var(--surface-card); }
+.job-thoughts label { font-weight: var(--weight-semibold); }
+.job-thoughts-field { position: relative; }
+.job-thoughts textarea { display: block; padding-right: 54px; resize: vertical; }
+.job-thoughts-mic { position: absolute; right: var(--space-2); bottom: var(--space-2); width: 40px; height: 40px; padding: var(--space-2); }
+.job-thoughts-mic svg { width: 18px; height: 18px; }
+.job-thoughts-mic[aria-pressed="true"] { color: var(--status-bad-fg); background: var(--status-bad-bg); }
