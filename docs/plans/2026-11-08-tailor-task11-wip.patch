+.job-match-band { border-radius: var(--radius-pill); padding: var(--space-1) var(--space-3); background: var(--status-neutral-bg); color: var(--status-neutral-fg); }
+.job-match-band.is-excellent, .job-match-band.is-strong { background: var(--pine-100); color: var(--pine-800); }
+.job-match-band.is-fair { background: var(--marigold-100); color: var(--marigold-800); }
+.job-match-band.is-low { background: var(--status-bad-bg); color: var(--status-bad-fg); }
+.job-score-requirements { display: grid; gap: var(--space-4); padding: 0; list-style: none; }
+.job-score-requirements li { display: flex; gap: var(--space-3); }
+.job-match-symbol { flex: none; font-weight: var(--weight-bold); }
+.job-match-met .job-match-symbol { color: var(--text-accent); }
+.job-match-missing .job-match-symbol { color: var(--status-bad-fg); }
+.job-score-points { display: grid; gap: var(--space-3); font-size: var(--text-sm); }
