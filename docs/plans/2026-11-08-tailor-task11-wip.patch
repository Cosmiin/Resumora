diff --git a/apps/web/src/jobs/JobScoreCard.tsx b/apps/web/src/jobs/JobScoreCard.tsx
new file mode 100644
index 0000000..109a78f
--- /dev/null
+++ b/apps/web/src/jobs/JobScoreCard.tsx
@@ -0,0 +1,51 @@
+import { useId, useState } from "react";
+import type { JobExtraction, MatchScore } from "@resumora/shared";
+import { t } from "../i18n/t.ts";
+
+type Props = { score: MatchScore; requirements: JobExtraction["requirements"] };
+const symbols = { met: "✓", partial: "~", missing: "✗" } as const;
+
+export function JobScoreCard({ score, requirements }: Props) {
+  const [showPoints, setShowPoints] = useState(false);
+  const pointsId = useId();
+  const requirementsChanged = score.labels.filter((label) => label.kind === "requirement").length !== requirements.length;
+  const rows = requirements.map((requirement, index) => {
+    const label = score.labels.find((item) => item.kind === "requirement" && item.ref === `r${index}`);
+    const status = label?.inferred ? "partial" : label?.status ?? "missing";
+    return { requirement, label, status };
+  });
+  const missing = rows.filter(({ requirement, status }) => requirement.kind === "must" && status === "missing").length;
+  return <section className="job-score" aria-label={t("job.score.title")}>
+    <h2>{t("job.score.title")}</h2>
+    {score.total === null ? <p>{t("job.score.notEnough")}</p> : <>
+      <div className="job-score-total"><strong>{score.total}<small>{t("job.score.outOf")}</small></strong>
+        {score.band && <span className={`job-match-band is-${score.band}`}>{t(`job.score.band.${score.band}`)}</span>}
+      </div>
+      {requirementsChanged ? <p className="jobs-note">{t("job.score.requirementsEdited")}</p> : <>
+      <p>{t("job.score.missingMusts", { n: missing })}</p>
+      <ul className="job-score-requirements">
+        {rows.map(({ requirement, label, status }, index) => <li key={index} className={`job-match-${status}`}>
+          <span className="job-match-symbol" aria-label={t(`job.score.status.${status}`)}>{symbols[status]}</span>
+          <div><strong>{requirement.text}</strong> <span className="jobs-note">{t(`job.${requirement.kind}`)}</span>
+            {label?.evidence && <p className="jobs-note">{label.evidence}</p>}
+            {requirement.kind === "must" && status === "missing" && <p className="jobs-note">{t("job.score.missingNext")}</p>}
+          </div>
+        </li>)}
+      </ul>
+      </>}
+    </>}
+    <button type="button" className="secondary" aria-expanded={showPoints} aria-controls={pointsId}
+      onClick={() => setShowPoints(!showPoints)}>{t("job.score.how")}</button>
+    {showPoints && <div id={pointsId}>
+      <dl className="job-score-points">
+        {(["requirements", "keywords", "seniority", "langEdu"] as const).map((key) => {
+          const part = score.parts[key];
+          return <div key={key}><dt>{t(`job.score.part.${key}`)}</dt>
+            <dd>{part ? t("job.score.points", { points: Math.round(part.points * part.max * 10) / 10, max: Math.round(part.max * 10) / 10 })
+              : t("job.score.notScored")}</dd></div>;
+        })}
+      </dl>
+      {score.capped && <p className="jobs-note">{t("job.score.capped")}</p>}
+    </div>}
+  </section>;
+}
diff --git a/apps/web/src/jobs/JobThoughts.tsx b/apps/web/src/jobs/JobThoughts.tsx
new file mode 100644
index 0000000..2316715
--- /dev/null
+++ b/apps/web/src/jobs/JobThoughts.tsx
@@ -0,0 +1,108 @@
+import { useCallback, useEffect, useLayoutEffect, useRef, useState } from "react";
+import { useVoice } from "../cv/enrich/useVoice.ts";
+import { ApiClientError } from "../lib/api.ts";
+import { t } from "../i18n/t.ts";
+
+type Props = { value: string | null; onSave(value: string): Promise<unknown>; onBusyChange?(busy: boolean): void };
+
+export function JobThoughts({ value, onSave, onBusyChange }: Props) {
+  const [text, setText] = useState(value ?? "");
+  const [saving, setSaving] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const latest = useRef(text);
+  const accepted = useRef(text);
+  const inFlight = useRef<string | null>(null);
+  const queued = useRef<string | null>(null);
+  const failed = useRef(false);
+  const field = useRef<HTMLTextAreaElement>(null);
+  useEffect(() => {
+    if (inFlight.current !== null || document.activeElement === field.current || latest.current !== accepted.current) return;
+    latest.current = value ?? "";
+    accepted.current = latest.current;
+    setText(latest.current);
+  }, [value]);
+  const saveAfterVoice = useRef(false);
+  const voice = useVoice({ locale: "en" });
+  const { state, onFinal } = voice;
+  const recording = state === "recording";
+  const counting = state === "countdown";
+  const busy = recording || counting || state === "asking" || state === "stopping";
+  useEffect(() => { onBusyChange?.(busy); }, [busy, onBusyChange]);
+  const micShown = state !== "denied" && state !== "unavailable" && state !== "limit";
+  const save = useCallback(async () => {
+    if (inFlight.current !== null) {
+      queued.current = latest.current === inFlight.current ? null : latest.current;
+      return;
+    }
+    if (latest.current === accepted.current) return;
+    queued.current = latest.current;
+    setSaving(true);
+    try {
+      while (queued.current !== null) {
+        const sent = queued.current;
+        queued.current = null;
+        if (sent === accepted.current) continue;
+        inFlight.current = sent;
+        setError(null);
+        try {
+          await onSave(sent);
+          accepted.current = sent;
+        } catch (cause) {
+          failed.current = true;
+          setError(t(cause instanceof ApiClientError && cause.code === "version_conflict"
+            ? "jobs.error.version_conflict" : "jobs.error.generic"));
+        }
+      }
+    } finally { inFlight.current = null; setSaving(false); }
+  }, [onSave]);
+  const cleanup = useRef({ save, stop: voice.stop, busy });
+  useLayoutEffect(() => { cleanup.current = { save, stop: voice.stop, busy }; }, [save, voice.stop, busy]);
+  useLayoutEffect(() => () => {
+    // Stop before useVoice's passive cleanup closes the microphone.
+    const current = cleanup.current;
+    if (current.busy) current.stop();
+    if (!failed.current && latest.current !== accepted.current) void current.save();
+  }, []);
+  useEffect(() => {
+    onFinal((words) => {
+      latest.current = [latest.current.trimEnd(), words].filter(Boolean).join(" ").slice(0, 2000);
+      setText(latest.current);
+    });
+  }, [onFinal]);
+  useEffect(() => {
+    if (!busy && saveAfterVoice.current) {
+      saveAfterVoice.current = false;
+      void save();
+    }
+  }, [busy, save]);
+  const message = state === "denied" ? t("job.thoughts.voiceDenied") : state === "limit" ? t("job.thoughts.voiceLimit")
+    : state === "idle" && voice.interrupted ? t("job.thoughts.voiceInterrupted") : null;
+  return <section className="job-thoughts">
+    <label htmlFor="job-thoughts">{t("job.thoughts.title")}</label>
+    <div className="job-thoughts-field">
+      <textarea id="job-thoughts" ref={field} maxLength={2000} rows={4} value={text} lang="en"
+        placeholder={t("job.thoughts.placeholder")} aria-describedby="job-thoughts-count"
+        onChange={(event) => { latest.current = event.target.value.slice(0, 2000); setText(latest.current); }}
+        onBlur={() => { if (busy) saveAfterVoice.current = true; else void save(); }} />
+      {micShown && <button type="button" className="secondary job-thoughts-mic" aria-pressed={recording}
+        aria-label={t(recording || counting ? "job.thoughts.voiceStop" : "job.thoughts.voiceStart")}
+        aria-busy={state === "asking" || state === "stopping"} disabled={state === "asking" || state === "stopping"}
+        onMouseDown={(event) => event.preventDefault()} onClick={() => {
+          field.current?.focus();
+          if (recording || counting) voice.stop();
+          else if (state === "idle") voice.start();
+        }}>
+        <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><rect x="5.5" y="1" width="5" height="9" rx="2.5" />
+          <path d="M3 7.5a5 5 0 0 0 10 0M8 12.5V15" fill="none" stroke="currentColor" strokeWidth="1.4" /></svg>
+      </button>}
+    </div>
+    <span id="job-thoughts-count" className="jobs-note">{t("job.thoughts.count", { n: text.length })}</span>
+    {busy && <p role="status" className="jobs-note">{t(counting ? "job.thoughts.voiceCountdown"
+      : recording ? "job.thoughts.voiceListening" : state === "asking" ? "job.thoughts.voiceConnecting" : "job.thoughts.voiceFinishing",
+    { n: voice.count ?? 0 })}</p>}
+    {voice.partial && <p aria-live="polite" lang="en">{voice.partial}</p>}
+    {message && <p role="status" className="jobs-note">{message}</p>}
+    {saving && <p role="status" className="jobs-note">{t("job.thoughts.saving")}</p>}
+    {error && <p role="alert" className="jobs-field-error">{error}</p>}
+  </section>;
+}
diff --git a/apps/web/src/jobs/TailorGate.tsx b/apps/web/src/jobs/TailorGate.tsx
new file mode 100644
index 0000000..db2f215
--- /dev/null
+++ b/apps/web/src/jobs/TailorGate.tsx
@@ -0,0 +1,65 @@
+import { useEffect, useRef } from "react";
+import type { CvContent } from "@resumora/shared";
+import { useMyCv } from "../cv/CvPage.tsx";
+import { useRoleScores } from "../cv/enrich/useRoleScores.ts";
+import { t } from "../i18n/t.ts";
+
+export const WEAK_AVG = 60;
+type Props = { onTailor(): void; onEnrich(): void; onClose(): void };
+
+export function TailorGate(props: Props) {
+  const cv = useMyCv();
+  const dialog = useRef<HTMLDivElement>(null);
+  useEffect(() => {
+    const previous = document.activeElement;
+    dialog.current?.focus();
+    return () => { if (previous instanceof HTMLElement) previous.focus(); };
+  }, []);
+  return <div className="jobs-scrim" onClick={(event) => { if (event.target === event.currentTarget) props.onClose(); }}>
+    <div className="add-job-dialog" role="dialog" aria-modal="true" aria-labelledby="tailor-gate-title"
+      tabIndex={-1} ref={dialog} onKeyDown={(event) => {
+        if (event.key === "Escape") { event.stopPropagation(); props.onClose(); }
+        if (event.key !== "Tab") return;
+        const buttons = event.currentTarget.querySelectorAll<HTMLButtonElement>("button:not(:disabled)");
+        const first = buttons[0];
+        const last = buttons[buttons.length - 1];
+        if (event.shiftKey && (document.activeElement === first || document.activeElement === dialog.current)) {
+          event.preventDefault(); last?.focus();
+        } else if (!event.shiftKey && (document.activeElement === last || document.activeElement === dialog.current)) {
+          event.preventDefault(); first?.focus();
+        }
+      }}>
+      <h2 id="tailor-gate-title">{t("job.gate.title")}</h2>
+      {cv.isPending ? <p role="status">{t("job.gate.checking")}</p> : cv.isError ? <>
+        <p role="alert">{t("job.gate.loadError")}</p>
+        <button type="button" onClick={() => void cv.refetch()}>{t("jobs.retry")}</button>
+      </> : <CheckCv cv={cv.data.content} {...props} />}
+      <button type="button" className="secondary" onClick={props.onClose}>{t("job.deleteCancel")}</button>
+    </div>
+  </div>;
+}
+
+function CheckCv({ cv, onTailor, onEnrich }: Props & { cv: CvContent }) {
+  const { scores } = useRoleScores({ cv, status: "saved" });
+  const newest = [...cv.experience].sort((a, b) => Number(b.current) - Number(a.current)
+    || (b.endDate || b.startDate).localeCompare(a.endDate || a.startDate) || b.startDate.localeCompare(a.startDate))[0];
+  const numbers = cv.experience.flatMap((role) => {
+    const score = scores.get(role.id)?.result?.score;
+    return typeof score === "number" ? [score] : [];
+  });
+  const missingFacts = !newest?.facts?.items.some((item) => item.trim());
+  const unknown = cv.experience.some((role) => {
+    const state = scores.get(role.id)?.state;
+    return state !== "ready" && state !== "none";
+  });
+  const weak = unknown || missingFacts || !numbers.length || numbers.reduce((sum, n) => sum + n, 0) / numbers.length < WEAK_AVG;
+  useEffect(() => { if (!weak) onTailor(); }, [weak, onTailor]);
+  if (!weak) return <p role="status">{t("job.gate.checking")}</p>;
+  return <>
+    <p>{t("job.gate.text")}</p>
+    <div className="jobs-dialog-actions">
+      <button type="button" onClick={onEnrich}>{t("job.gate.enrich")}</button>
+      <button type="button" className="secondary" onClick={onTailor}>{t("job.gate.anyway")}</button>
+    </div>
+  </>;
+}
