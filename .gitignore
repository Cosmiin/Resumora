/references/screenshots/*
!/references/screenshots/.gitkeep

# Local environment and Worker credential files, at any directory depth.
.env*
.dev.vars*

# Local application tooling and generated build output.
node_modules/
dist/
.wrangler/

# Supabase CLI link/cache state; never publish credential-bearing local metadata.
/supabase/.temp/
/supabase/.branches/

# Python verification bytecode.
__pycache__/

apps/api/.generated/
/apps/web/public/downloads/resumora-extension.zip
